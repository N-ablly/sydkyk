{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo request confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "preview_token",
    "expected_version",
    "payload"
  ],
  "properties": {
    "kind": {
      "enum": [
        "leave",
        "expense",
        "app_access",
        "coe",
        "payroll_case",
        "lost_device",
        "desk",
        "invoice",
        "onboarding",
        "employee_relations"
      ]
    },
    "preview_token": {
      "type": "string",
      "minLength": 16
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "$comment": "Server validates per-kind fields and derives tenant, subject, actor and roles from verified claims. This envelope schema alone is not sufficient business validation."
}
