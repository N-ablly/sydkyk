# Sydkyk demo environment variables. Copy to .env.local for local development.
# Never commit real values. In Vercel: Project → Settings → Environment Variables.

# Supabase (leads, admin sign-in, rate limits). Project Settings → API Keys in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; only used for admin sign-in.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server only: full database access, bypasses row-level security.
SUPABASE_SECRET_KEY=

# Anthropic API key for free-text answers (Phase 2). Server only.
SYDKYK_ANTHROPIC_API_KEY=

# Google Chat app (POST /experience/api/google-chat). The endpoint answers 503 until the audience is set.
# Must match the app's "Authentication audience" in Google Cloud → Google Chat API → Configuration:
# the project number, or https://sydkyk.vercel.app/experience/api/google-chat.
GOOGLE_CHAT_AUDIENCE=
# Only for a Chat app built as a Workspace add-on: its service account
# (service-<project-number>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com).
# GOOGLE_CHAT_SERVICE_ACCOUNT=
# Optional: whose record and permissions Chat answers with (S01–S20, default S01 · Ana Reyes).
# GOOGLE_CHAT_SCENARIO=S01

# Optional: dedicated key for signing the demo-session cookie.
# If unset, it is derived from SUPABASE_SECRET_KEY.
# DEMO_SESSION_SECRET=
