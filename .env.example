# Sydkyk demo environment variables. Copy to .env.local for local development.
# Never commit real values. In Vercel: Project → Settings → Environment Variables.

# Supabase (leads, admin sign-in, rate limits). Project Settings → API Keys in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; only used for admin sign-in.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server only: full database access, bypasses row-level security.
SUPABASE_SECRET_KEY=

# Anthropic API key for free-text answers (Phase 2). Server only.
SYDKYK_ANTHROPIC_API_KEY=

# Optional: dedicated key for signing the demo-session cookie.
# If unset, it is derived from SUPABASE_SECRET_KEY.
# DEMO_SESSION_SECRET=
